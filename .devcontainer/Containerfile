FROM docker.io/debian:forky

RUN apt update && \
    apt upgrade -y && \
    apt install -y rustup \
    python3 \
    pkg-config \
    gcc \
    mold \
    clang \
    git \
    curl \
    bats \
    shellcheck \
    go-md2man \
    # building the UI
    libudev-dev \
    libwayland-dev \
    # testing the UI
    xdotool xvfb libxcursor1 libxi6 libxfixes3 libxcb-xkb1 libxkbcommon-x11-0

ENV RUSTUP_HOME=/opt/rust
ENV CARGO_HOME=/opt/rust

RUN rustup toolchain install stable && \
    rustup default stable && \
    rustup component add clippy rust-analyzer

RUN chmod 777 /opt/rust
