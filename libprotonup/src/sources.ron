[
    (
        name: "GEProton",
        forge: GitHub,
        repository_account: "GloriousEggroll",
        repository_name: "proton-ge-custom",
        tool_type: WineBased,
        // Historical naming eras: `GE-Proton<major>-<minor>` and the older
        // `Proton-<ver>-GE-<rev>`. Version segments are intentionally opaque.
        release_asset_filter: Some(Prefixes(["GE-Proton", "Proton-"])),
        compatible_applications: [Steam, Lutris],
    ),
    (
        name: "Luxtorpeda",
        forge: GitHub,
        repository_account: "luxtorpeda-dev",
        repository_name: "luxtorpeda",
        tool_type: Runtime,
        compatible_applications: [Steam],
        file_name_template: Some("Luxtorpeda-{version}")
    ),
    (
        name: "Boxtron",
        forge: GitHub,
        repository_account: "dreamer",
        repository_name: "boxtron",
        tool_type: Runtime,
        compatible_applications: [Steam],
        file_name_template: Some("Boxtron-{version}")
    ),
    (
        name: "VKD3D-Proton",
        forge: GitHub,
        repository_account: "HansKristian-Work",
        repository_name: "vkd3d-proton",
		tool_type: Runtime,
        compatible_applications: [Lutris],
        file_name_template: Some("VKD3D-Proton-{version}")
    ),
    (
        name: "Lutris-VKD3D",
        forge: GitHub,
        repository_account: "lutris",
        repository_name: "vkd3d",
        tool_type: Runtime,
        compatible_applications: [Lutris],
        file_name_replacement: Some(("Proton","Wine")),
        subfolder: Some("runtime"),
        file_name_template: Some("VKD3D-Lutris-{version}")
    ),
    (
        name: "DXVK",
        forge: GitHub,
        repository_account: "doitsujin",
        repository_name: "dxvk",
        tool_type: Runtime,
        compatible_applications: [Lutris],
        release_asset_filter: Some(Prefix("dxvk-")),
        has_multiple_asset_variations: true,
        file_name_template: Some("DXVK-{version}")
    ),
    (
        name: "Kron4ek Wine",
        forge: GitHub,
        repository_account: "kron4ek",
        repository_name: "Wine-Builds",
        tool_type: WineBased,
        compatible_applications: [Lutris],
        release_asset_filter: Some(Prefix("wine-")),
        file_name_template: Some("kron4ek-wine-{version}")
    ),
    (
        name: "GEProton RTSP",
        forge: GitHub,
        repository_account: "SpookySkeletons",
        repository_name: "proton-ge-rtsp",
        tool_type: WineBased,
        // Two naming eras: `GE-Proton<maj>-<min>-rtsp<rev>-<n>` and the newer
        // `proton-rtsp-<ver>-<date>-<n>`.
        release_asset_filter: Some(Prefixes(["GE-Proton", "proton-rtsp-"])),
        compatible_applications: [Steam],
    ),
    (
        name: "Proton CachyOS",
        forge: GitHub,
        repository_account: "CachyOS",
        repository_name: "proton-cachyos",
        tool_type: WineBased,
        release_asset_filter: Some(Prefix("proton-cachyos-")),
        has_multiple_asset_variations: true,
        compatible_applications: [Steam, Lutris],
    ),
    (
        name: "Proton Wineland",
        forge: GitHub,
        repository_account: "nanomatters",
        repository_name: "proton-salkim",
        tool_type: WineBased,
        release_asset_filter: Some(Prefix("proton-wineland-")),
        has_multiple_asset_variations: true,
        compatible_applications: [Steam, Lutris],
    ),
    (
        name: "WineGE (Deprecated)",
        forge: GitHub,
        repository_account: "GloriousEggroll",
        repository_name: "wine-ge-custom",
        tool_type: WineBased,
        compatible_applications: [Steam, Lutris],
        file_name_replacement: Some(("Proton","Wine")),
        file_name_template: Some("proton-wineland-{version}")
    ),
]
